#!/usr/bin/env bash
#
# fzf-menu - Run a declarative menu of actions through an fzf picker
#
# Usage: fzf-menu <name>
#        fzf-menu --popup <name>     size a tmux popup to the menu and run in it
#        fzf-menu --explain <cmd>    render the fzf preview for one entry
#        fzf-menu --run <cmd>        run one entry, as a menu item does
#
# Loads <menu dir>/<name>.menu, presents its entries with pick_one, and runs
# the selected command. The menu directory defaults to `menus/` beside this
# script and can be overridden with FZF_MENU_DIR.
#
# --popup is what the tmux binding calls: it counts the menu's entries,
# computes a height, and re-runs this script inside a display-popup of that
# size. --explain is called by fzf for the highlighted row.
#
# Menu file format — one file per menu:
#   # Description, shown as the picker's prompt
#   Label<TAB>command
#   Label<TAB>@window command
#
# A leading sigil on the command decides where it runs:
#   (none)    run in this popup, pause for a keypress
#   @window   new tmux window in the current pane's directory
#   @pane     send-keys into the current pane
#   @bg       detached, output appended to ~/.cache/fzf-menu.log
#   @menu     another menu, in this same popup
#   @pick     a command that draws its own menu or popup (the *-pick scripts)
#
# Example:
#   fzf-menu git

set -o errexit   # abort on nonzero exitstatus
set -o nounset   # abort on unbound variable
set -o pipefail  # don't hide errors within pipes

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/output.sh"
source "${SCRIPT_DIR}/lib/picker.sh"
source "${SCRIPT_DIR}/lib/menu.sh"

readonly MENU_DIR="${FZF_MENU_DIR:-${SCRIPT_DIR}/menus}"
readonly MENU_LOG="${HOME}/.cache/fzf-menu.log"

# Popup geometry for --popup.
#
# This popup is BORDERED (no -B), unlike the pickers' own: it hosts a bare
# command's output as well as the picker, and the border is what separates
# that output from the pane behind. fzf is therefore told `--border none`, or
# there would be two. The cost is accepted: a border glyph sits in the outer
# ring tmux repaints on a DECSET 2026 flush, so it tears while something
# animates behind it.
#
# The chrome accounting changed with that and the total did not, which is
# worth spelling out because it looks like a coincidence and is not quite one.
# Borderless it was: margin 1, fzf's own border 2, prompt 1, preview 1, the
# rule above it 1, and 1 row fzf keeps for itself - 7, against a usable
# interior of the full height. Bordered it is prompt 1, preview 1, rule 1 and
# fzf's own row - 4, against an interior of height - 2, so height is
# entries + 6. fzf's border and the margin both went: tmux's border replaces
# the first and makes the second a wasted row.
#
# MEASURED, not derived: tests/manual counts visible entries at known pane
# heights, and an estimate that was one row short made every menu scroll.
# Past POPUP_MAX_ITEMS the list scrolls rather than growing further.
# Height grows with the entry count between these bounds, so a 3-entry menu
# is not handed the same box as a 20-entry one.
#
# Keep in step with lib/picker.sh's argv and fzf-menu's --preview-window: any
# change to the padding, the border, or the preview height moves this
# constant, and the only symptom of getting it wrong is a popup slightly too
# big or too small.
readonly POPUP_WIDTH=74
readonly POPUP_CHROME_ROWS=6
readonly POPUP_MAX_ITEMS=15

# Exit status for "the menu could not be run", distinct from "nothing picked",
# which is a successful no-op.
readonly MENU_UNAVAILABLE=2

# How many @menu hops one invocation may make. menu.menu chaining into a leaf
# is one hop, so anything beyond a handful is a cycle rather than a design.
# Geometry for a bare command's own popup, opened from a native menu item.
# Percentages rather than the menu's fixed width: this holds arbitrary command
# output, not a list sized to its contents.
readonly RUN_POPUP_WIDTH="80%"
readonly RUN_POPUP_HEIGHT="60%"

# The prompt shown once a bare command has finished. -s so the keypress is not
# echoed into the output the user is reading, and a rule above it so the
# prompt is visibly separate from the command's own output rather than looking
# like one more line of it. Escape counts: read -n1 returns on the ESC byte,
# so it needs no special case, only saying so.
readonly RUN_POPUP_PAUSE="printf '\\n%s\\n' \"\$(printf '=%.0s' \$(seq 1 \${COLUMNS:-60}))\"; read -rsn 1 -p 'Done. Press any key (or Esc) to close... ' _"

readonly MENU_MAX_DEPTH=8
readonly MENU_DEPTH="${FZF_MENU_DEPTH:-0}"

#######################################
# Print usage information
# Outputs:
#   Writes usage information to stdout
#######################################
usage() {
  printf '%s\n' \
    "Usage: ${0##*/} <name>" \
    "       ${0##*/} --popup <name>   size a tmux popup and run in it" \
    "       ${0##*/} --explain <cmd>  render the preview for one entry" \
    "       ${0##*/} --run <cmd>      run one entry, as a menu item does" \
    "" \
    "Run a declarative menu of actions through an fzf picker." \
    "" \
    "Menus are read from ${MENU_DIR}/<name>.menu" \
    "" \
    "Available menus:"
  local name
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    printf '  %s\n' "${name}"
  done < <(list_menus)
}

#######################################
# List the available menu names, one per line.
# Outputs:
#   Menu names to stdout, nothing if the directory is absent or empty
#######################################
list_menus() {
  local file
  for file in "${MENU_DIR}"/*.menu; do
    [ -f "${file}" ] || continue
    basename "${file}" .menu
  done
}

#######################################
# Print a menu's description: its first line with the leading "# " stripped,
# or the menu's own name when the file does not open with a comment.
#
# This becomes the fzf PROMPT rather than a `--header`. A header under
# `--style full` is a bordered section of its own - three or four rows and a
# label - which is a lot of furniture to say "Git actions" above six rows
# that are self-evidently git actions. The prompt says the same thing in the
# line that has to exist anyway.
# Arguments:
#   Path to the menu file
# Outputs:
#   Description text to stdout
#######################################
menu_header() {
  local file="${1}"
  local first=""
  IFS= read -r first < "${file}" || first=""
  case "${first}" in
    '#'*) printf '%s' "${first#\# }" ;;
    *)    printf '%s' "$(basename "${file}" .menu)" ;;
  esac
}

#######################################
# Convert a menu file into picker rows.
#
# Emits "command<TAB>label" so the label is the last field and pick_one's
# default --with-nth of -1 displays it while the command rides along hidden.
# A malformed line is warned about and skipped rather than aborting the menu:
# one bad row must not cost the user the other nine.
# Arguments:
#   Path to the menu file
# Outputs:
#   Rows to stdout, warnings to stderr
#######################################
menu_rows() {
  local file="${1}"
  local base
  base="$(basename "${file}")"
  local lineno=0
  local emitted=0
  local line label command

  while IFS= read -r line || [ -n "${line}" ]; do
    lineno=$((lineno + 1))
    [ -z "${line}" ] && continue
    case "${line}" in '#'*) continue ;; esac

    case "${line}" in
      *$'\t'*) ;;
      *)
        warn "${base}:${lineno}: no tab separator, skipping"
        continue
        ;;
    esac

    label="${line%%$'\t'*}"
    command="${line#*$'\t'}"
    if [ -z "${label}" ] || [ -z "${command}" ]; then
      warn "${base}:${lineno}: empty label or command, skipping"
      continue
    fi

    emitted=$((emitted + 1))
    if [ "${emitted}" -le 9 ]; then
      printf '%s\t%s %s\n' "${command}" "${emitted}" "${label}"
    else
      printf '%s\t  %s\n' "${command}" "${label}"
    fi
  done < "${file}"
}

#######################################
# Run a bare command in a popup of its own and wait for a keypress.
#
# run_action's bare branch assumes it is already inside the fzf popup. A menu
# item is not: display-menu runs a tmux command with nowhere to write, so the
# output needs a popup built for it. Bordered, matching the other popups that
# show command output.
# Arguments:
#   The command to run
#######################################
run_in_popup() {
  local body="${1}"
  tmux display-popup -E -w "${RUN_POPUP_WIDTH}" -h "${RUN_POPUP_HEIGHT}" \
    -d '#{pane_current_path}' \
    "${body}; ${RUN_POPUP_PAUSE}" \
    || warn "display-popup failed"
}

#######################################
# Run a menu entry chosen from a native menu.
#
# Identical to run_action except for the bare case, which has no popup to
# write into and so is given one.
# Arguments:
#   The command string, sigil included
# Returns:
#   0 on success, MENU_UNAVAILABLE on an unknown sigil
#######################################
run_action_from_menu() {
  local command="${1}"
  if [ -z "$(action_sigil "${command}")" ]; then
    run_in_popup "$(action_body "${command}")"
    return 0
  fi
  run_action "${command}"
}

#######################################
# Run a selected menu command according to its leading sigil.
#
# The sigil answers "where does this run", which is the one thing a flat
# label-to-command table cannot express and the usual reason a menu would
# otherwise have to become a script.
# Arguments:
#   The command string, sigil included
# Returns:
#   0 on success, MENU_UNAVAILABLE on an unknown sigil
#######################################
run_action() {
  local command="${1}"
  local sigil body
  sigil="$(action_sigil "${command}")"
  body="$(action_body "${command}")"

  if [ "${sigil}" = "unknown" ]; then
    error "unknown sigil in: ${command}"
    return "${MENU_UNAVAILABLE}"
  fi

  case "${sigil}" in
    window)
      # A failing action must not look like a failing menu, so its status is
      # reported rather than propagated (same contract as the bare case
      # below). Without this, `errexit` kills the script at the failing tmux
      # call and nothing is printed at all.
      tmux new-window -c "#{pane_current_path}" "${body}" || warn "new-window failed"
      ;;
    pane)
      # -l types the body literally; without it tmux resolves each argument
      # as a key name first, so a body that is itself a key name (e.g. "up")
      # or starts with a flag-like token is sent as a key instead of typed.
      tmux send-keys -l -- "${body}" || warn "send-keys failed"
      tmux send-keys Enter || warn "send-keys failed"
      ;;
    bg)
      mkdir -p "$(dirname "${MENU_LOG}")"
      nohup sh -c "${body}" >> "${MENU_LOG}" 2>&1 &
      info "running in background, logging to ${MENU_LOG/#${HOME}/~}"
      ;;
    pick)
      # The command runs its own picker - a native menu when the list fits,
      # its own popup when it has to fall back to fzf. Wrapping it in a popup
      # here is what made "Review PR" open an empty box: a display-menu cannot
      # draw while a popup is already up.
      sh -c "${body}" || warn "picker exited ${?}"
      ;;
    menu)
      # Two menus that name each other would exec back and forth forever, and
      # inside a tmux popup that looks like a hang with nothing to interrupt.
      # menus.bats enforces that only menu.menu chains, but that guard covers
      # the menus in this repo and not a menu dir someone points
      # FZF_MENU_DIR at.
      if [ "${MENU_DEPTH}" -ge "${MENU_MAX_DEPTH}" ]; then
        error "menu chain too deep (${MENU_MAX_DEPTH}), stopping: @menu ${body}"
        return "${MENU_UNAVAILABLE}"
      fi
      # exec, not a subshell: this process has nothing left to do, and
      # replacing it keeps the popup's exit status the target menu's own.
      # No keypress pause either - the user is moving between screens of the
      # same popup, not reading command output.
      FZF_MENU_DEPTH=$((MENU_DEPTH + 1)) exec "${SCRIPT_DIR}/fzf-menu" "${body}"
      ;;
    *)
      # A failing action must not look like a failing menu, so its status is
      # reported rather than propagated - and reported before the pause, so it
      # is readable instead of flashing past as the popup closes.
      # A leading blank line keeps the popup's top row empty. That row is the
      # overlay's outer ring, which tmux repaints when a pane flushes a
      # DECSET 2026 frame, so anything printed there tears - the same reason
      # the picker itself runs with --margin 1. fzf's margin does not cover
      # this branch, because by now fzf has exited and the command is writing
      # to the popup directly.
      printf '\n'
      local status=0
      sh -c "${body}" || status="${?}"
      # PICKER_QUIET_EXIT means the action decided nothing happened - a picker
      # the user escaped out of. There is nothing on screen to read, so close
      # without the pause rather than making the user press a key to dismiss
      # a popup they already dismissed.
      if [ "${status}" -eq "${PICKER_QUIET_EXIT}" ]; then
        return 0
      fi
      if [ "${status}" -ne 0 ]; then
        warn "exited ${status}"
      fi
      # And a trailing one, so the last row stays empty too.
      printf '\n'
      # Only pause when there is a terminal to pause for. The prompt exists so
      # a popup does not close before its output can be read; with no tty
      # (a test, a pipe) there is nothing to wait on and blocking would hang.
      if [ -t 0 ]; then
        read -r -n 1 -p "Press any key to close... " _ || true
      fi
      ;;
  esac
}

#######################################
# Name the sigil a menu command carries.
#
# Deliberately two functions rather than one that returns "sigil<TAB>body":
# unpacking that with `IFS=$'\t' read` silently mangles a bare command,
# because tab is IFS *whitespace*, so the leading empty field collapses and
# the first word of the command lands in the sigil variable.
# Arguments:
#   The command string, sigil included
# Outputs:
#   window | pane | bg | unknown, or nothing at all for a bare command
#######################################
action_sigil() {
  case "${1}" in
    '@window '*) printf 'window' ;;
    '@pane '*)   printf 'pane' ;;
    '@bg '*)     printf 'bg' ;;
    '@menu '*)   printf 'menu' ;;
    '@pick '*)   printf 'pick' ;;
    '@'*)        printf 'unknown' ;;
    *)           printf '' ;;
  esac
}

#######################################
# Strip a menu command's sigil, leaving the command that actually runs.
# An unrecognised @word is returned untouched: there is no body to isolate,
# and the caller reports it as an error rather than running it.
# Arguments:
#   The command string, sigil included
# Outputs:
#   The command without its sigil
#######################################
action_body() {
  local command="${1}"
  case "$(action_sigil "${command}")" in
    window) printf '%s' "${command#@window }" ;;
    pane)   printf '%s' "${command#@pane }" ;;
    bg)     printf '%s' "${command#@bg }" ;;
    menu)   printf '%s' "${command#@menu }" ;;
    pick)   printf '%s' "${command#@pick }" ;;
    *)      printf '%s' "${command}" ;;
  esac
}

#######################################
# Render the fzf preview for one menu command.
#
# The list shows a label and the raw field shows menu syntax; neither is the
# thing that actually executes. Print the real command on its own line, then
# say in words where it will run, so `@window git rebase -i origin/main`
# reads as the rebase it is rather than as a sigil the reader must decode.
# Arguments:
#   The command string, sigil included
# Outputs:
#   Preview text to stdout
#######################################
explain_action() {
  local sigil body
  sigil="$(action_sigil "${1}")"
  body="$(action_body "${1}")"

  # The command alone. An unrecognised sigil is the one case worth a second
  # line, because the entry will not run at all and the label gives no hint.
  if [ "${sigil}" = "unknown" ]; then
    printf '%s\nUNKNOWN SIGIL - this entry will not run\n' "${body}"
  elif [ "${sigil}" = "menu" ]; then
    printf 'opens the %s menu\n' "${body}"
  elif [ "${sigil}" = "pick" ]; then
    printf '%s\n' "${body}"
  else
    printf '%s\n' "${body}"
  fi
}

#######################################
# Count a menu file's pickable rows.
# Arguments:
#   Path to the menu file
# Outputs:
#   The count to stdout, 0 for a missing or empty menu
#######################################
menu_row_count() {
  local file="${1}"
  local count
  count="$(menu_rows "${file}" 2>/dev/null | grep -c . || true)"
  [ -n "${count}" ] || count=0
  printf '%s' "${count}"
}

#######################################
# Rows of the tallest screen this menu can reach: its own, or any menu one of
# its @menu rows opens.
#
# popup() builds the tmux popup before fzf-menu runs inside it, so the box has
# to be big enough for every screen that popup will show. One level deep, by
# design: menu.menu chains into the leaf menus and the leaf menus chain into
# nothing, so recursion would buy nothing and could not terminate on a cycle.
# A target that does not exist is skipped rather than counted as zero.
# Arguments:
#   Path to the menu file
# Outputs:
#   The row count to stdout
#######################################
menu_max_rows() {
  local file="${1}"
  local max row command target target_file target_rows
  max="$(menu_row_count "${file}")"

  while IFS= read -r row; do
    [ -n "${row}" ] || continue
    # menu_rows emits "command<TAB>N label"; the label is the last field.
    command="${row%$'\t'*}"
    [ "$(action_sigil "${command}")" = "menu" ] || continue
    target="$(action_body "${command}")"
    target_file="${MENU_DIR}/${target}.menu"
    [ -f "${target_file}" ] || continue
    target_rows="$(menu_row_count "${target_file}")"
    if [ "${target_rows}" -gt "${max}" ]; then
      max="${target_rows}"
    fi
  done < <(menu_rows "${file}" 2>/dev/null)

  printf '%s' "${max}"
}

#######################################
# Menu rows with the digit prefix removed.
#
# menu_rows numbers labels for fzf, which has no key column of its own. tmux
# draws the key at the end of the item line, so a native menu must not carry
# the number as well.
# Arguments:
#   Path to the menu file
# Outputs:
#   "command<TAB>label" rows to stdout
#######################################
menu_rows_unnumbered() {
  local file="${1}"
  local row command label
  while IFS= read -r row; do
    [ -n "${row}" ] || continue
    command="${row%$'\t'*}"
    label="${row##*$'\t'}"
    # "1 Fetch" -> "Fetch"; "  Fetch" -> "Fetch"
    label="${label#[0-9] }"
    label="${label#  }"
    printf '%s\t%s\n' "${command}" "${label}"
  done < <(menu_rows "${file}")
}

#######################################
# Re-run this script inside a tmux popup sized to the menu it will show.
#
# The height has to be computed out here: the binding creates the popup
# before fzf-menu runs, and tmux cannot count the rows of a file. A menu of
# three entries and a menu of twenty should not get the same box.
# Arguments:
#   Menu name
# Returns:
#   0 on success, MENU_UNAVAILABLE if the menu does not exist
#######################################
popup() {
  local name="${1:-}"
  local file="${MENU_DIR}/${name}.menu"

  if [ -z "${name}" ] || [ ! -f "${file}" ]; then
    error "no such menu: ${name:-<none>}"
    error "available: $(list_menus | tr '\n' ' ')"
    return "${MENU_UNAVAILABLE}"
  fi

  local count
  count="$(menu_max_rows "${file}")"

  # A native menu when it will fit. menu_max_rows, not the file's own row
  # count: a chaining menu has to fit the tallest screen it can reach, or
  # picking a leaf blanks it.
  if menu_fits "${count}"; then
    menu_rows_unnumbered "${file}" \
      | menu_show "$(menu_header "${file}")" \
          "$(printf '%q' "${SCRIPT_DIR}/fzf-menu") --run"
    return "${?}"
  fi

  local shown="${count}"
  [ "${shown}" -gt "${POPUP_MAX_ITEMS}" ] && shown="${POPUP_MAX_ITEMS}"
  [ "${shown}" -lt 1 ] && shown=1
  local height=$((shown + POPUP_CHROME_ROWS))

  tmux display-popup -EE -w "${POPUP_WIDTH}" -h "${height}" \
    -d '#{pane_current_path}' \
    "$(printf '%q' "${SCRIPT_DIR}/fzf-menu") $(printf '%q' "${name}")"
}

#######################################
# Main function
#
# Only PICKER_NO_SELECTION (the user pressed Escape, or there was nothing to
# show) is a successful no-op. Any other nonzero from pick_one - notably
# PICKER_UNAVAILABLE when fzf itself cannot run - is a real failure and must
# propagate rather than being swallowed as "nothing picked". Task 3's
# run_action inherits this same contract.
# Arguments:
#   Menu name
# Returns:
#   0 on success or on no selection, MENU_UNAVAILABLE on a bad invocation,
#   or whatever nonzero status pick_one reports
#######################################
main() {
  local name="${1:-}"

  if [ -z "${name}" ]; then
    error "missing required argument: menu name"
    printf '\n'
    usage
    return "${MENU_UNAVAILABLE}"
  fi

  local file="${MENU_DIR}/${name}.menu"
  if [ ! -f "${file}" ]; then
    error "no such menu: ${name}"
    error "available: $(list_menus | tr '\n' ' ')"
    return "${MENU_UNAVAILABLE}"
  fi

  local rows
  rows="$(menu_rows "${file}")"

  # --size "" renders fzf inline rather than in a popup of its own. This menu
  # is always invoked from a `display-popup` binding, and a nested popup has
  # no client to draw on: fzf exits 0 printing nothing, the selection is lost,
  # and the popup closes on that success status. Inline fills the popup we are
  # already in, which is the geometry the binding's -w/-h already chose.
  # The preview re-enters this script with --explain so it can resolve the
  # sigil into the command that actually runs plus where it runs, rather than
  # showing raw menu syntax the reader has to decode.
  # One keypress per entry, which is the thing a tmux display-menu does well
  # and an fzf picker normally does not. pos(N) needs the `load` event: at
  # `start` the list is not populated yet and the jump is a no-op.
  local count binds n
  count="$(printf '%s\n' "${rows}" | grep -c . || true)"
  [ -n "${count}" ] || count=0
  # The digit binds MUST come first and the transform LAST.
  #
  # fzf's `transform-preview-label:` takes everything after the colon as its
  # command, to the end of the --bind string - commas included. With the
  # transform first, `1:pos(1)+accept,2:pos(2)+accept` was silently swallowed
  # into the transform's command instead of being parsed as bindings, so no
  # digit key ever did anything. fzf reports no error for this; the only
  # symptom is keys that quietly do nothing.
  binds=""
  n=1
  while [ "${n}" -le 9 ] && [ "${n}" -le "${count}" ]; do
    binds="${binds}${binds:+,}${n}:pos(${n})+accept"
    n=$((n + 1))
  done
  # .fzfrc binds focus:transform-preview-label to print "Previewing [row]".
  # Re-binding the same event blanks it; a static --preview-label cannot,
  # because the transform reruns on every focus change. `true` prints
  # nothing, which is the label we want and needs no quoting.
  binds="${binds}${binds:+,}focus:transform-preview-label:true"

  local selection status=0
  selection="$(printf '%s\n' "${rows}" \
    | pick_one --size "" --prompt "$(menu_header "${file}")> " \
        --style default \
        --border none \
        --margin 0 \
        --preview "$(printf '%q' "${SCRIPT_DIR}/fzf-menu") --explain {1}" \
        --info hidden \
        --preview-window 'down,1,border-top,wrap,noinfo' \
        ${binds:+--bind "${binds}"})" \
    || status="${?}"

  if [ "${status}" -eq "${PICKER_NO_SELECTION}" ] \
    || [ "${status}" -eq "${PICKER_EMPTY}" ]; then
    return 0
  fi
  if [ "${status}" -ne 0 ]; then
    return "${status}"
  fi

  # The label is the last field and cannot contain a tab, so stripping the
  # final field leaves the command intact even if it contains tabs itself.
  local command="${selection%$'\t'*}"

  run_action "${command}"
}

# Check for help flag
# ${1+...} is for bash 3.2, which is still /bin/bash on a stock macOS and
# on the macos-latest runner: there "${@}" with no positional parameters is
# an unbound variable under `set -o nounset` rather than an empty list, so a
# no-argument run aborted here instead of printing usage.
if help_wanted ${1+"${@}"}; then
  usage
  exit 0
fi

case "${1:-}" in
  # Called by fzf for each highlighted row, not by a human.
  --explain)
    shift
    explain_action "${1:-}"
    exit 0
    ;;
  # What the tmux binding calls: sizes a popup to the menu, then re-runs
  # this script inside it.
  --popup)
    shift
    popup "${1:-}"
    exit "${?}"
    ;;
  # The act half. Invoked by a display-menu item, which runs a tmux command
  # rather than handing a selection back.
  --run)
    shift
    if [ "${#}" -lt 1 ] || [ -z "${1}" ]; then
      error "missing required argument: command"
      exit "${MENU_UNAVAILABLE}"
    fi
    run_action_from_menu "${1}"
    exit "${?}"
    ;;
esac

# Run main function
main ${1+"${@}"}
