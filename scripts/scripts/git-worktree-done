#!/usr/bin/env bash
#
# git-worktree-done - Switch away from a worktree session and clean it up
#
# Usage: git-worktree-done
#
# When run from inside a git worktree tmux session, confirms the removal,
# then switches to the most recently used other tmux session and opens a
# popup to run git-worktree-cleanup for the current worktree.
#
# The confirmation runs first and cancelling is a no-op: nothing is switched
# and nothing is removed. SCRIPTS_PKG_DIR overrides where sibling scripts are
# looked up, which is how the tests point the gate at a recorder.
#
# Example:
#   git-worktree-done

set -o errexit   # abort on nonzero exitstatus
set -o nounset   # abort on unbound variable
set -o pipefail  # don't hide errors within pipes

# Get script directory and source common functions
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/common.sh"

# TEMPORARY - diagnostic instrumentation for vigil's session-removal latency.
# Remove once vigil/docs/superpowers/specs/2026-08-03-session-hopping-design.md
# part C has a timeline. That path is in the VIGIL repo, not this one; read it
# and vigil/docs/superpowers/2026-08-03-session-hopping-handoff.md before
# deleting, in case it is still open.
readonly HOP_TIMING_LOG="/tmp/vigil-hop-timing.log"
stamp() {
  printf '%s %s\n' \
    "$(perl -MTime::HiRes -e 'printf "%.3f", Time::HiRes::time')" \
    "${1}" >> "${HOP_TIMING_LOG}" || true
}

#######################################
# Print usage information
# Outputs:
#   Writes usage information to stdout
#######################################
usage() {
  cat <<USAGE
Usage: ${0##*/}

Switch away from the current worktree tmux session and clean it up.

Must be run from inside a git worktree that has a corresponding tmux session.
Switches to the most recently used other tmux session, then opens a popup
running git-worktree-cleanup for the current worktree directory.

Example:
  ${0##*/}
    Switches to the last session and cleans up the current worktree
USAGE
}

#######################################
# Main function
# Returns:
#   0 on success, 1 on failure
#######################################
main() {
  stamp 'done: main entry'

  # The confirmed re-entry is told which worktree and session it agreed to,
  # rather than recomputing them. It runs under a menu item's `run-shell -b`,
  # by which point the focused pane is whatever the user is looking at - which
  # need not be the worktree the menu named.
  local confirmed="" agreed_path="" agreed_session=""
  if [ "${1:-}" = "--confirmed" ]; then
    confirmed=1
    agreed_path="${2:-}"
    agreed_session="${3:-}"
  fi

  # Must be in tmux
  if ! is_in_tmux; then
    error "Not running in tmux"
    return 1
  fi

  # SCRIPTS_PKG_DIR, like the gate below: the cleanup is now run directly
  # rather than inside a popup, so without an override the tests would really
  # remove things instead of recording that they were asked to.
  local cleanup_script="${SCRIPTS_PKG_DIR:-${SCRIPT_DIR}}/git-worktree-cleanup"
  if [ ! -x "${cleanup_script}" ]; then
    error "git-worktree-cleanup not found or not executable: ${cleanup_script}"
    return 1
  fi

  local current_session worktree_path target_session current_client
  current_session="$(tmux display-message -p '#S')"
  worktree_path="$(tmux display-message -p '#{pane_current_path}')"
  current_client="$(tmux display-message -p '#{client_name}')"

  # Pane path may be stale (e.g. leftover .removing dir) — fall back to session path
  if [[ ! -d "${worktree_path}" ]]; then
    worktree_path="$(tmux display-message -p '#{session_path}')"
  fi

  [ -n "${agreed_path}" ] && worktree_path="${agreed_path}"
  [ -n "${agreed_session}" ] && current_session="${agreed_session}"

  # Find the most recently used session other than the current one
  target_session="$(tmux list-sessions -F '#{session_last_attached}|#{session_name}' | \
    sort -rn | \
    awk -F'|' -v cur="${current_session}" '$2 != cur { print $2; exit }')"

  if [ -z "${target_session}" ]; then
    error "No other tmux session to switch to"
    error "Create another session before running cleanup"
    return 1
  fi

  # Ask before anything irreversible. Placed ahead of the switch so a cancel
  # leaves the user exactly where they were, and well ahead of the cleanup
  # popup, because git-worktree-cleanup kills the session and moves the
  # worktree aside the moment it starts.
  #
  # wt-confirm draws its own menu or popup: this script runs under
  # `bind-key d run-shell -b`, which has no tty to prompt on.
  #
  # It is handed the rest of this script as the action rather than asked for
  # an answer, because `tmux display-menu` does not reliably block until its
  # menu is answered - a gate read afterwards always reported a cancel. The
  # re-entry carries --confirmed so it skips the gate rather than asking twice.
  #
  # SCRIPT_DIR, not SCRIPTS_PKG_DIR: that override points sibling dispatches at
  # test recorders, and this names THIS script.
  if [ -z "${confirmed}" ]; then
    local confirm_script="${SCRIPTS_PKG_DIR:-${SCRIPT_DIR}}/wt-confirm"
    if [ ! -x "${confirm_script}" ]; then
      error "wt-confirm not found or not executable: ${confirm_script}"
      return 1
    fi
    # Silent on the decline path. This runs under `run-shell -b`, which
    # surfaces stdout in the pane, so anything printed here outlives the menu
    # the user just dismissed.
    "${confirm_script}" \
      --run "$(printf '%q' "${SCRIPT_DIR}/${0##*/}") --confirmed $(printf '%q' "${worktree_path}") $(printf '%q' "${current_session}")" \
      "${worktree_path}" "${current_session}" || true
    return 0
  fi

  # Switch away first so cleanup can safely kill the current session
  tmux switch-client -c "${current_client}" -t "=${target_session}"
  stamp 'done: switch-client returned'

  # NO POPUP. Removing a worktree is fire-and-forget: the confirmation already
  # happened, the session leaving vigil's list is the feedback, and nobody
  # reads cleanup output. This ran in a `display-popup` from 2026-03-02 until
  # it was removed; the argument for it was legibility of scrolling output,
  # which is worth nothing against a box that appears after every `prefix d`.
  #
  # Runs under `run-shell -b`, so stdout goes to the focused pane and is
  # usually swallowed by whatever is on the alternate screen. That is fine and
  # is the point.
  stamp 'done: running cleanup'
  "${cleanup_script}" --session "${current_session}" "${worktree_path}" || true
  stamp 'done: cleanup returned'

  return 0
}

# Check for help flag
# ${1+...} is for bash 3.2, which is still /bin/bash on a stock macOS and
# on the macos-latest runner: there "${@}" with no positional parameters is
# an unbound variable under `set -o nounset` rather than an empty list, so a
# no-argument run aborted here instead of printing usage.
if help_wanted ${1+"${@}"}; then
  usage
  exit 0
fi

# Run main function
main ${1+"${@}"}
