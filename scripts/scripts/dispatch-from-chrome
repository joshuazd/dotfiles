#!/usr/bin/env bash
#
# dispatch-from-chrome - Get the active Chrome tab URL and dispatch it
#
# Intended to be invoked by the SwiftBar dispatch plugin (terminal=false).
# Gets the active tab URL from Google Chrome, validates it looks like a
# Shortcut story or GitHub PR, brings a tmux client to the front (so the
# job's closing switch-client has somewhere to land), and hands the URL to
# `vigil dispatch`, which submits it to vigild. No popup is opened here.

set -o errexit
set -o nounset
set -o pipefail

# Send a macOS notification
notify() {
  osascript -e "display notification \"${*}\" with title \"Dispatch\""
}

# Path where get_chrome_url stashes osascript's stderr so main() can surface
# the real error (e.g. "-1743: not authorized to send Apple events") instead
# of a generic "could not get URL" message.
readonly CHROME_ERR="$(mktemp /tmp/dispatch-chrome-err-XXXXXX)"

# Get the URL of the active tab in Google Chrome
get_chrome_url() {
  osascript -e \
    'tell application "Google Chrome" to return URL of active tab of first window' \
    2>"${CHROME_ERR}" || true
}

# Find the name of the most recently active tmux session
get_tmux_session() {
  tmux list-sessions -F "#{session_last_attached} #{session_name}" 2>/dev/null \
    | sort -rn \
    | head -1 \
    | awk '{print $2}'
}

main() {
  local repo="portal"
  while [ "${#}" -gt 0 ]; do
    case "${1}" in
      --repo)
        repo="${2}"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  if [ ! -d "${HOME}/${repo}" ]; then
    notify "Unknown repo: ${repo}"
    exit 1
  fi

  local url
  url="$(get_chrome_url)"

  if [[ -z "${url}" ]]; then
    local err
    err="$(cat "${CHROME_ERR}" 2>/dev/null)"
    rm -f "${CHROME_ERR}"
    if [[ -n "${err}" ]]; then
      notify "Could not get Chrome tab URL: ${err}"
    else
      notify "Could not get Chrome tab URL - is Chrome running?"
    fi
    exit 1
  fi
  rm -f "${CHROME_ERR}"

  if ! [[ "${url}" =~ app\.shortcut\.com ]] && \
     ! [[ "${url}" =~ github\.com.*/pull/ ]]; then
    notify "Not a Shortcut story or GitHub PR: ${url}"
    exit 0
  fi

  # Bring a client to the front before submitting. The job ends with a
  # switch-client, and vigild resolves the most recently active client to
  # switch: with nothing attached anywhere there is nothing for the teleport
  # to land on, so attach a window first.
  ensure_client

  if ! vigil dispatch --cwd "${HOME}/${repo}" "${url}"; then
    notify "Dispatch failed - see the vigil panel or vigild.log"
    exit 1
  fi
}

#######################################
# Make sure some tmux client exists and iTerm2 is in front, so the job's
# closing switch-client has a client to act on.
#######################################
ensure_client() {
  local tmux_session tmux_path
  # get_tmux_session's pipeline starts with `tmux list-sessions`, which fails
  # outright when no server is running at all - the exact no-client-anywhere
  # case this function exists to handle. Under errexit that failure would
  # abort the script here, before vigil dispatch ever runs, so it is guarded
  # to yield an empty tmux_session instead.
  tmux_session="$(get_tmux_session)" || true

  if [[ -n "${tmux_session}" ]] && \
     tmux list-clients -t "${tmux_session}" 2>/dev/null | grep -q .; then
    # Fail soft: a denied Apple-events grant (-1743) must not take the
    # dispatch down with it.
    osascript -e 'tell application "iTerm2" to activate' || true
    return 0
  fi

  if [[ -z "${tmux_session}" ]]; then
    osascript -e 'tell application "iTerm2" to activate' || true
    return 0
  fi

  tmux_path="$(command -v tmux)"
  osascript <<APPLESCRIPT || true
tell application "iTerm2"
  activate
  if (count of windows) = 0 then
    create window with default profile command "${tmux_path} attach -t ${tmux_session}"
  else
    tell current window
      create tab with default profile command "${tmux_path} attach -t ${tmux_session}"
    end tell
  end if
end tell
APPLESCRIPT

  local deadline=$(( SECONDS + 5 ))
  while ! tmux list-clients -t "${tmux_session}" 2>/dev/null | grep -q .; do
    if [ "${SECONDS}" -ge "${deadline}" ]; then
      notify "Timed out waiting for a tmux client to attach"
      return 0
    fi
    sleep 0.1
  done
}

main "$@"
