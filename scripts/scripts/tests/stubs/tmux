#!/usr/bin/env bash
# Test stub. Records argv to $TMUX_STUB_LOG, one invocation per line,
# arguments joined by the unit separator so embedded spaces stay parseable.
set -o nounset

# Exit status for the whole invocation. A branch that wants to fail sets this
# rather than exiting, so the call is still recorded with its full argv - a
# test asserting what was asked needs the failed query in the log too.
stub_status=0

# Whether this invocation names a client with -c. Matched as a whole argument:
# a substring test against "${*}" also matches "switch-client" and any client
# name containing "-c".
stub_has_client=""
for stub_arg in "${@}"; do
  if [ "${stub_arg}" = "-c" ]; then
    stub_has_client=1
    break
  fi
done

# Canned responses for the queries lib/tmux.sh and vigil-panel make.
case "${1:-}" in
  display-message)
    # Keyed on the requested format. One canned answer for every
    # display-message would feed client dimensions into a pane-width query,
    # so a mutant asking the wrong question would still get the right answer.
    #
    # The client branch uses ${VAR-default}, not ${VAR:-default}: an
    # explicitly empty value is the no-client case and must survive.
    case "${*}" in
      *client_height*|*client_width*)
        # A -c query measures a named client; without it tmux measures the
        # calling client. The two have to be answerable separately, or no test
        # can tell "the named client answered" from "some client answered" -
        # which is the whole of the fallback under test.
        if [ -n "${stub_has_client}" ]; then
          if [ -n "${TMUX_STUB_CLIENT_DISPLAY_FAILS:-}" ]; then
            stub_status=1
          else
            printf '%s\n' "${TMUX_STUB_CLIENT_DISPLAY-${TMUX_STUB_DISPLAY-40 200}}"
          fi
        else
          printf '%s\n' "${TMUX_STUB_DISPLAY-40 200}"
        fi
        ;;
      *pane_width*)
        printf '%s\n' "${TMUX_STUB_PANE_WIDTH:-200}"
        ;;
      *window_id*)
        printf '%s\n' "${TMUX_STUB_WINDOW_ID:-@3}"
        ;;
      *pane_current_path*)
        # ${VAR-default}, not ${VAR:-default}: an explicitly empty value is the
        # "cannot resolve the directory" case and must survive, the same way the
        # no-client case does above.
        printf '%s\n' "${TMUX_STUB_PANE_PATH-/tmp/stub-worktree}"
        ;;
      *)
        printf '%s\n' "${TMUX_STUB_DISPLAY:-/tmp/stub-worktree}"
        ;;
    esac
    ;;
  has-session)
    exit "${TMUX_STUB_HAS_SESSION:-1}"
    ;;
  switch-client)
    # A client that detached during the job, or a window that is gone: tmux
    # refuses and the caller must survive it.
    if [ -n "${TMUX_STUB_SWITCH_FAILS:-}" ]; then
      stub_status=1
    fi
    ;;
  list-clients)
    if [ -n "${TMUX_STUB_LIST_CLIENTS:-}" ]; then
      printf '%s\n' "${TMUX_STUB_LIST_CLIENTS}"
    fi
    ;;
  list-sessions)
    # TMUX_STUB_LIST_SESSIONS_FAILS simulates no server being reachable at
    # all - `tmux list-sessions` itself fails, distinct from a server that is
    # up but has no sessions (which is the unset-TMUX_STUB_LIST_SESSIONS
    # default: exit 0, no output).
    if [ -n "${TMUX_STUB_LIST_SESSIONS_FAILS:-}" ]; then
      if [ -n "${TMUX_STUB_LOG:-}" ]; then
        printf 'list-sessions\n' >> "${TMUX_STUB_LOG}"
      fi
      exit 1
    fi
    if [ -n "${TMUX_STUB_LIST_SESSIONS:-}" ]; then
      printf '%s\n' "${TMUX_STUB_LIST_SESSIONS}"
    fi
    ;;
  list-panes)
    if [ -n "${TMUX_STUB_LIST_PANES:-}" ]; then
      printf '%s\n' "${TMUX_STUB_LIST_PANES}"
    fi
    ;;
  show-options)
    # Keyed by option name: the toggle asks for two different options and a
    # single canned value would feed an orientation into the size.
    for arg in "${@}"; do
      case "${arg}" in
        @vigil_panel_orientation) printf '%s\n' "${TMUX_STUB_PANEL_ORIENTATION:-}" ;;
        @vigil_panel_size) printf '%s\n' "${TMUX_STUB_PANEL_SIZE:-}" ;;
      esac
    done
    ;;
  start-server)
    if [ -n "${TMUX_STUB_START_SERVER_FAILS:-}" ]; then
      if [ -n "${TMUX_STUB_LOG:-}" ]; then
        printf 'start-server\n' >> "${TMUX_STUB_LOG}"
      fi
      exit 1
    fi
    ;;
  split-window)
    if [ -n "${TMUX_STUB_SPLIT_FAILS:-}" ]; then
      # Log it before bailing: a test asserting nothing followed the failure
      # still needs to see that the split was attempted.
      if [ -n "${TMUX_STUB_LOG:-}" ]; then
        printf 'split-window\n' >> "${TMUX_STUB_LOG}"
      fi
      exit 1
    fi
    # Only -P asks for the new pane id back.
    for arg in "${@}"; do
      if [ "${arg}" = "-P" ]; then
        printf '%s\n' "${TMUX_STUB_SPLIT_PANE:-%9}"
        break
      fi
    done
    ;;
esac

if [ -n "${TMUX_STUB_LOG:-}" ]; then
  printf '%s' "${1:-}" >> "${TMUX_STUB_LOG}"
  shift || true
  # The count guard is for bash 3.2, which is what /bin/bash is on a stock
  # macOS and on the macos-latest runner: there "${@}" with no positional
  # parameters left is an unbound variable under `set -o nounset`, not an
  # empty list, and the stub exits non-zero before recording anything.
  # "tmux start-server" is the only call with no arguments after the
  # subcommand, so it was the only one that tripped it.
  if [ "${#}" -gt 0 ]; then
    for arg in "${@}"; do
      printf '\x1f%s' "${arg}" >> "${TMUX_STUB_LOG}"
    done
  fi
  printf '\n' >> "${TMUX_STUB_LOG}"
fi

exit "${stub_status}"
