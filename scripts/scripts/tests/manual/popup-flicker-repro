#!/usr/bin/env bash
#
# popup-flicker-repro - Reproduce the tmux popup flicker in any terminal
#
# Usage: popup-flicker-repro [small|full|title]
#
#   full   (default) the pane repaints its WHOLE screen ~12x/sec, the way a
#          full TUI such as an agent session does
#   small  the pane rewrites a dozen characters in one spot ~12x/sec
#   title  the pane writes nothing but re-sends the SAME OSC 2 window title
#          ~12x/sec, with set-titles on, so tmux retitles the outer terminal
#          on every one
#
# Opens a throwaway tmux server (socket "flickrepro") with one repainting
# pane, then binds prefix + g to a display-popup over it. Watch the popup's
# borders. Runs on its own socket and never touches your real sessions, so it
# is safe from a second terminal while your normal tmux keeps working.
#
# THE STATUS BAR IS DELIBERATELY STATIC HERE. status-interval was tested and
# eliminated as a cause, so this repro must not reintroduce it as a variable:
# the pane is the only thing repainting.
#
# What is measured, on tmux 3.7b: tmux draws the popup overlay INSIDE
# synchronized-output blocks (DECSET 2026) but writes the underlying pane's
# output OUTSIDE them - 18/19 overlay writes inside sync, 66/71 pane writes
# outside.
#
# OBSERVED SO FAR, in Terminal.app and iTerm2 alike:
#   full   no flicker      whole-screen repaint 12x/sec
#   small  no flicker      localised write 12x/sec
#   title  no flicker      unchanged OSC 2 title 12x/sec
#   real Claude Code session  FLICKERS in both terminals
#
# So it is not output volume, not the renderer, and not window titles.
#
# `tmux pipe-pane` on a live Claude pane gives the answer. Its frame, 10x/sec,
# 64 bytes, and NONE of the synthetic modes above emitted any of it:
#
#   ESC[?2026h  ESC[?25l  ESC[H  SGR  <text>  ESC[?25h  ESC[?2026l
#   sync begin  cur hide  home        draw    cur show  sync end
#
# Two things there are new. The pane opens and closes the TERMINAL's
# synchronized-update brackets - the same mechanism tmux uses for its own
# overlay redraws, measured at 18/19 overlay writes inside sync blocks - so
# the pane and tmux are both driving frame boundaries and can cross. And the
# cursor is hidden and shown 10x/sec while a popup owns the cursor.
#
# RESULTS, all observed by eye, which has been more reliable here than any
# byte-counting harness:
#
#   agent     FLICKERS      the captured frame, replayed
#   sync      FLICKERS      2026 brackets only
#   cursor    steady        cursor hide/show only
#   sync-off  FLICKERS      2026 brackets with Sync@ set before attach
#
# sync vs cursor isolates it to the pane's DECSET 2026 brackets: the two
# modes draw identically and differ only in which private mode they toggle.
#
# The decisive detail is that this reproduces in Terminal.app, which does not
# implement 2026 at all and simply ignores those bytes. So the tear is not a
# terminal mishandling crossed frame boundaries - the terminal never sees a
# frame boundary. tmux itself parses the pane's 2026, batches the pane output,
# and the flush repaints the overlay.
#
# That is also why `terminal-overrides ...:Sync@` does nothing (sync-off): it
# governs what tmux EMITS, not how tmux REACTS to a pane's brackets. There is
# no tmux option for the latter, so there is no local fix - the levers are
# upstream in tmux, or Claude Code not emitting 2026 inside tmux.
#
# SURFACE RESULTS against an animating pane:
#
#   bordered popup            tears
#   borderless popup          steady
#   fullscreen popup          steady   (border sits at the screen edge)
#   popup + fzf --margin 1    steady   <- what the menu ships
#   display-menu, framed      tears
#   display-menu, no border   tears    (the TITLE tears on its own)
#   display-menu, bare        steady
#   menu stacked over a popup n/a      tmux will not draw one over the other
#
# The rule: any drawn cell on the overlay's outermost ring tears - box
# glyphs, ASCII glyphs and title text alike - and blank cells cannot. fzf
# escapes with --margin, which insets its border by one cell. display-menu
# has no margin option and puts its border and title at the edge by
# construction, so it is steady only when bare.
#
# TERMINALS TESTED, all tear identically:
#   iTerm2 3.6.10   GPU renderer, supports DECSET 2026
#   Terminal.app    CPU renderer
#   Ghostty         GPU renderer with damage tracking
#
# Three independent renderers, including a modern damage-tracking one, is
# what makes "this is tmux, not the terminal" evidence rather than inference.
# Renderer settings were also eliminated one at a time on iTerm2: adaptive
# framerate, Metal, maximize throughput, transparency and blur.
#
# Minimal upstream repro: this script, `sync` versus `cursor`, tmux 3.7b.
# Press q or Escape to close the popup, then C-b d to tear the server down.

set -o errexit
set -o nounset
set -o pipefail

readonly SOCK=flickrepro
readonly MODE="${1:-full}"

case "${MODE}" in
  full | small | title | agent | sync | cursor | sync-off) ;;
  *)
    printf 'Usage: %s [full|small|title|agent|sync|cursor|sync-off]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

cleanup() {
  tmux -L "${SOCK}" kill-server 2> /dev/null || true
}
trap cleanup EXIT

tmux -L "${SOCK}" kill-server 2> /dev/null || true

# `full` uses the alternate screen and rewrites every line from the home
# position, which is what a TUI does. `small` writes in place with \r.
# `title` writes almost nothing but re-sends the SAME OSC 2 window title
# ~12x/sec, which is what an agent session appears to do and what neither of
# the other two modes exercises.
#
# The single quotes are deliberate: $i, $RANDOM and $SECONDS must expand in
# the pane's own shell each iteration, not once here while the string is
# being built. Hence the SC2016 exemptions.
case "${MODE}" in
  full)
    # shellcheck disable=SC2016
    pane_cmd='printf "\033[?1049h"; while :; do printf "\033[H"; i=1; while [ "$i" -le 45 ]; do printf "line %02d  %s\033[K\n" "$i" "$RANDOM"; i=$((i+1)); done; perl -e "select undef,undef,undef,0.08"; done'
    ;;
  small)
    # shellcheck disable=SC2016
    pane_cmd='while :; do printf "\rrepainting %s  " "${SECONDS}"; perl -e "select undef,undef,undef,0.08"; done'
    ;;
  title)
    # Unchanged text on purpose: the question is whether tmux reacts to the
    # SEQUENCE arriving, not to the value differing. A stable value is why
    # sampling #{pane_title} showed nothing while the flicker was happening.
    # shellcheck disable=SC2016
    pane_cmd='printf "title mode: resending the same OSC 2 title 12x/sec\n"; while :; do printf "\033]2;claude working\033\\"; perl -e "select undef,undef,undef,0.08"; done'
    ;;
  agent)
    # The exact frame a Claude Code pane emits, 10x/sec, captured via
    # `tmux pipe-pane`: sync begin, cursor hide, tiny draw, cursor show,
    # sync end. 64 bytes. Note the pane opens and closes the TERMINAL's
    # frame boundaries, which tmux also uses for its own overlay redraws.
    pane_cmd='while :; do printf "\033[?2026h\033[?25l\033[H\033[1magent frame\033[0m\033[?25h\033[?2026l"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
  sync)
    # Bisect half one: synchronized-output brackets only, no cursor toggle.
    pane_cmd='while :; do printf "\033[?2026h\033[H\033[1msync only \033[0m\033[?2026l"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
  sync-off)
    # Identical pane to `sync`, but the server drops the Sync capability
    # before the client attaches. This is the ONLY trustworthy test of
    # whether `terminal-overrides ...:Sync@` actually suppresses a pane's
    # relayed 2026 brackets - a byte-counting harness gave inconsistent
    # answers, a human watching a border does not.
    pane_cmd='while :; do printf "\033[?2026h\033[H\033[1msync off  \033[0m\033[?2026l"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
  cursor)
    # Bisect half two: cursor hide/show only, no sync brackets.
    pane_cmd='while :; do printf "\033[?25l\033[H\033[1mcursor only\033[0m\033[?25h"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
esac

tmux -L "${SOCK}" new-session -d -s repro "sh -c '${pane_cmd}'"

# Static status bar: no clock, no interval churn, nothing to redraw.
tmux -L "${SOCK}" set -g status-interval 0
tmux -L "${SOCK}" set -g status-right ''
tmux -L "${SOCK}" set -g status-left " flicker repro: ${MODE} mode "

# Mirror the real config's title forwarding, which is what `title` mode
# exercises: with set-titles on, every pane-title sequence tmux receives is
# re-emitted to the outer terminal as a window retitle. allow-rename off
# matches too - it stops the window NAME changing while still letting the
# pane title through, so this is not testing a rename storm.
if [ "${MODE}" = sync-off ]; then
  tmux -L "${SOCK}" set -ags terminal-overrides ',*:Sync@'
fi

tmux -L "${SOCK}" set -g set-titles on
tmux -L "${SOCK}" set -g set-titles-string '#S:#I:#W - "#T" #{session_alerts}'
tmux -L "${SOCK}" setw -g allow-rename off

# Four surfaces, so one run compares them all. They differ in whether tmux
# draws an overlay at all, how much of the screen it covers, and whether
# there is a border to tear.
popup_body="printf '  Mode: %s\n  Watch for tearing.\n  q or Escape to close.\n' '${MODE}'; read -r -n 1 _ || true"

# g: the current surface - bordered popup over the animating pane.
tmux -L "${SOCK}" bind-key g display-popup -EE -w 72 -h 17 "${popup_body}"

# f: full screen. No popup/pane edge is visible, so if the tear only shows
# where the overlay meets the pane, this hides it.
tmux -L "${SOCK}" bind-key f display-popup -EE -w 100% -h 100% "${popup_body}"

# n: no border at all, tmux's or the command's. Isolates whether it is the
# border specifically that tears rather than the whole overlay.
tmux -L "${SOCK}" bind-key n display-popup -EE -B -w 72 -h 17 "${popup_body}"

# M: cycle menu-border-lines through every value tmux accepts, so each can
# be compared against the same menu. `padded` is the interesting one: a
# border made of blank cells rather than line characters, which is what you
# want if the line drawing is what tears but you still want the inset and
# the title.
#
# shellcheck disable=SC2016  # must evaluate in the pane shell, not here
tmux -L "${SOCK}" bind-key M run-shell \
  'cur=$(tmux -L flickrepro show -gv menu-border-lines); case "$cur" in single) n=rounded ;; rounded) n=double ;; double) n=heavy ;; heavy) n=simple ;; simple) n=padded ;; padded) n=none ;; *) n=single ;; esac; tmux -L flickrepro set -g menu-border-lines "$n"; tmux -L flickrepro display-message "menu-border-lines: $n"'

# P: stack a menu ON TOP of a blank popup. The popup is opened in the
# background and the menu drawn over it a moment later, so the menu's outer
# cells sit over static popup content rather than over the animating pane.
# Same principle that makes a fullscreen popup steady: nothing live is
# adjacent to the edge that tmux repaints.
#
# shellcheck disable=SC2016  # must evaluate in the pane shell, not here
tmux -L "${SOCK}" bind-key P run-shell -b \
  'tmux -L flickrepro display-popup -B -w 80 -h 24 "perl -e \"select undef,undef,undef,20\"" >/dev/null 2>&1 & sleep 0.4; tmux -L flickrepro display-menu -T " over a popup " -x C -y C "stacked first" 1 "" "stacked second" 2 "" "" "close" q ""'

# S: cycle menu-style so a borderless menu can be made to stand out by
# filling its background instead of framing it. The open question is whether
# a filled background reaches the overlay's outer ring: a bare menu is
# steady, which suggests tmux keeps a blank ring even with border lines off,
# and filling it may put drawn cells back on the edge that tears.
#
# shellcheck disable=SC2016  # must evaluate in the pane shell, not here
tmux -L "${SOCK}" bind-key S run-shell \
  'cur=$(tmux -L flickrepro show -gv menu-style); case "$cur" in *bg=colour4*) n="bg=colour0,fg=colour7"; d="dim block" ;; *bg=colour0*) n="default"; d="default" ;; *) n="bg=colour4,fg=colour15,bold"; d="bright block" ;; esac; tmux -L flickrepro set -g menu-style "$n"; tmux -L flickrepro set -g menu-selected-style "bg=colour15,fg=colour0,bold"; tmux -L flickrepro display-message "menu-style: $d"'

# G: a borderless menu that still reads as a titled block. Two tricks:
#
#   - the title is a DISABLED ITEM ("-Git actions"), not -T. A -T title is
#     drawn on the border row, which is the outer ring that tears; an item
#     sits inside the menu body, so it is both steady and covered by
#     menu-style's background fill.
#   - separators are a disabled item with a blank name rather than "".
#     tmux renders "" as a rule line styled separately from menu-style,
#     which leaves an uncoloured gap through an otherwise solid block.
#
# Pair with C-b S to fill the background.
# The `--` is load-bearing: an item name starting with "-" is otherwise
# parsed as a flag, and tmux rejects the whole command with
# "invalid flag - ". A leading "-" is what marks an item disabled.
tmux -L "${SOCK}" bind-key G display-menu -x C -y C -- \
  "-  Git actions"        "" "" \
  "- "                    "" "" \
  "  1 Fetch and prune"   1  "" \
  "  2 Status"            2  "" \
  "  3 Rebase on main"    3  "" \
  "- "                    "" "" \
  "  q Close"             q  ""

# T: display-menu with NO title. The title text tears even with the border
# off, so title and border are separate contributors and both have to go for
# a steady menu. Pair with C-b M to test all four combinations.
tmux -L "${SOCK}" bind-key T display-menu -x C -y C \
  "titleless first"  1 "" \
  "titleless second" 2 "" \
  "titleless third"  3 "" \
  "" \
  "close"            q ""

# m: display-menu, tmux's own menu primitive rather than a popup running a
# program. Different draw path, and for a six-item menu arguably the better
# UI anyway - single-key selection, no fuzzy matching needed.
tmux -L "${SOCK}" bind-key m display-menu -T " display-menu " -x C -y C \
  "first item"  1 "" \
  "second item" 2 "" \
  "third item"  3 "" \
  "" \
  "close"       q ""

printf 'Throwaway tmux server "%s" is up in %s mode.\n' "${SOCK}" "${MODE}"
printf 'Surfaces:  C-b g popup   C-b f fullscreen   C-b n borderless   C-b m menu   C-b M cycle border style   C-b T menu (no title)   C-b P menu over popup   C-b S cycle colours   C-b G titled block\n'
printf 'C-b d detaches and tears the server down.\n'
printf 'Modes: full small title agent sync cursor sync-off\n'
printf 'Start with agent - it replays the real captured frame. If that\n'
printf 'flickers, sync and cursor bisect which half is responsible.\n\n'

tmux -L "${SOCK}" attach -t repro
