#!/usr/bin/env bash
#
# popup-flicker-repro - Reproduce the tmux popup flicker in any terminal
#
# Usage: popup-flicker-repro
#
# Opens a throwaway tmux server (socket "flickrepro") with one pane that
# repaints continuously, standing in for an agent's spinner, then opens a
# display-popup over it. Watch the popup's borders.
#
# Runs on its own socket and never touches your real sessions, so it is safe
# to run from a second terminal while your normal tmux keeps working.
#
# Why this exists: tmux draws the popup overlay INSIDE synchronized-output
# blocks (DECSET 2026) but writes the underlying pane's output OUTSIDE them.
# Measured on tmux 3.7b: 18/19 overlay writes inside sync, 66/71 pane writes
# outside. Interleaving unsynchronized pane writes with atomic overlay
# redraws is the suspected cause of the visible tearing.
#
# Interpreting the result:
#   flickers here too, in a terminal with no 2026 support (Terminal.app)
#     -> tmux output behaviour, independent of renderer and of sync
#   steady in a second terminal but not in the first
#     -> that terminal's renderer; compare a third with sync support
#
# Press q or Escape to close the popup, then the script tears the server down.

set -o errexit
set -o nounset
set -o pipefail

readonly SOCK=flickrepro

cleanup() {
  tmux -L "${SOCK}" kill-server 2> /dev/null || true
}
trap cleanup EXIT

tmux -L "${SOCK}" kill-server 2> /dev/null || true

# A pane that repaints ~12 times a second with no other activity.
tmux -L "${SOCK}" new-session -d -s repro \
  "while :; do printf '\rrepainting %s  ' \"\${SECONDS}\"; perl -e 'select undef,undef,undef,0.08'; done"

# Match the real setup: top status bar, seconds ticking, one-second interval.
tmux -L "${SOCK}" set -g status-position top
tmux -L "${SOCK}" set -g status-interval 1
tmux -L "${SOCK}" set -g status-right ' %H:%M:%S '

# prefix + g opens the popup, so the flicker can be triggered repeatedly
# without restarting. prefix is C-b on this throwaway server.
tmux -L "${SOCK}" bind-key g display-popup -EE -w 72 -h 17 \
  "printf '  Watch the borders.\n  q or Escape to close.\n'; read -r -n 1 _ || true"

printf 'Throwaway tmux server "%s" is up.\n' "${SOCK}"
printf 'Attaching now. Press C-b g to open the popup; q to close it.\n'
printf 'Detach with C-b d and the server is torn down.\n\n'

tmux -L "${SOCK}" attach -t repro
