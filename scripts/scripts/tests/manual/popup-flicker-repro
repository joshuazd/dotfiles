#!/usr/bin/env bash
#
# popup-flicker-repro - Reproduce the tmux popup flicker in any terminal
#
# Usage: popup-flicker-repro [small|full|title]
#
#   full   (default) the pane repaints its WHOLE screen ~12x/sec, the way a
#          full TUI such as an agent session does
#   small  the pane rewrites a dozen characters in one spot ~12x/sec
#   title  the pane writes nothing but re-sends the SAME OSC 2 window title
#          ~12x/sec, with set-titles on, so tmux retitles the outer terminal
#          on every one
#
# Opens a throwaway tmux server (socket "flickrepro") with one repainting
# pane, then binds prefix + g to a display-popup over it. Watch the popup's
# borders. Runs on its own socket and never touches your real sessions, so it
# is safe from a second terminal while your normal tmux keeps working.
#
# THE STATUS BAR IS DELIBERATELY STATIC HERE. status-interval was tested and
# eliminated as a cause, so this repro must not reintroduce it as a variable:
# the pane is the only thing repainting.
#
# What is measured, on tmux 3.7b: tmux draws the popup overlay INSIDE
# synchronized-output blocks (DECSET 2026) but writes the underlying pane's
# output OUTSIDE them - 18/19 overlay writes inside sync, 66/71 pane writes
# outside.
#
# OBSERVED SO FAR, in Terminal.app and iTerm2 alike:
#   full   no flicker      whole-screen repaint 12x/sec
#   small  no flicker      localised write 12x/sec
#   title  no flicker      unchanged OSC 2 title 12x/sec
#   real Claude Code session  FLICKERS in both terminals
#
# So it is not output volume, not the renderer, and not window titles.
#
# `tmux pipe-pane` on a live Claude pane gives the answer. Its frame, 10x/sec,
# 64 bytes, and NONE of the synthetic modes above emitted any of it:
#
#   ESC[?2026h  ESC[?25l  ESC[H  SGR  <text>  ESC[?25h  ESC[?2026l
#   sync begin  cur hide  home        draw    cur show  sync end
#
# Two things there are new. The pane opens and closes the TERMINAL's
# synchronized-update brackets - the same mechanism tmux uses for its own
# overlay redraws, measured at 18/19 overlay writes inside sync blocks - so
# the pane and tmux are both driving frame boundaries and can cross. And the
# cursor is hidden and shown 10x/sec while a popup owns the cursor.
#
#   agent flickers
#     -> the captured frame is the trigger; bisect with sync and cursor
#   sync flickers, cursor does not
#     -> crossed synchronized-update brackets. tmux bug, reportable.
#   cursor flickers, sync does not
#     -> cursor visibility churn under an overlay
#   agent steady
#     -> the frame alone is not enough; something about the real session's
#        timing or size matters. Capture again over a longer window and
#        compare byte-for-byte rather than adding another guess.
#
# Press q or Escape to close the popup, then C-b d to tear the server down.

set -o errexit
set -o nounset
set -o pipefail

readonly SOCK=flickrepro
readonly MODE="${1:-full}"

case "${MODE}" in
  full | small | title | agent | sync | cursor | sync-off) ;;
  *)
    printf 'Usage: %s [full|small|title|agent|sync|cursor|sync-off]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

cleanup() {
  tmux -L "${SOCK}" kill-server 2> /dev/null || true
}
trap cleanup EXIT

tmux -L "${SOCK}" kill-server 2> /dev/null || true

# `full` uses the alternate screen and rewrites every line from the home
# position, which is what a TUI does. `small` writes in place with \r.
# `title` writes almost nothing but re-sends the SAME OSC 2 window title
# ~12x/sec, which is what an agent session appears to do and what neither of
# the other two modes exercises.
#
# The single quotes are deliberate: $i, $RANDOM and $SECONDS must expand in
# the pane's own shell each iteration, not once here while the string is
# being built. Hence the SC2016 exemptions.
case "${MODE}" in
  full)
    # shellcheck disable=SC2016
    pane_cmd='printf "\033[?1049h"; while :; do printf "\033[H"; i=1; while [ "$i" -le 45 ]; do printf "line %02d  %s\033[K\n" "$i" "$RANDOM"; i=$((i+1)); done; perl -e "select undef,undef,undef,0.08"; done'
    ;;
  small)
    # shellcheck disable=SC2016
    pane_cmd='while :; do printf "\rrepainting %s  " "${SECONDS}"; perl -e "select undef,undef,undef,0.08"; done'
    ;;
  title)
    # Unchanged text on purpose: the question is whether tmux reacts to the
    # SEQUENCE arriving, not to the value differing. A stable value is why
    # sampling #{pane_title} showed nothing while the flicker was happening.
    # shellcheck disable=SC2016
    pane_cmd='printf "title mode: resending the same OSC 2 title 12x/sec\n"; while :; do printf "\033]2;claude working\033\\"; perl -e "select undef,undef,undef,0.08"; done'
    ;;
  agent)
    # The exact frame a Claude Code pane emits, 10x/sec, captured via
    # `tmux pipe-pane`: sync begin, cursor hide, tiny draw, cursor show,
    # sync end. 64 bytes. Note the pane opens and closes the TERMINAL's
    # frame boundaries, which tmux also uses for its own overlay redraws.
    pane_cmd='while :; do printf "\033[?2026h\033[?25l\033[H\033[1magent frame\033[0m\033[?25h\033[?2026l"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
  sync)
    # Bisect half one: synchronized-output brackets only, no cursor toggle.
    pane_cmd='while :; do printf "\033[?2026h\033[H\033[1msync only \033[0m\033[?2026l"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
  sync-off)
    # Identical pane to `sync`, but the server drops the Sync capability
    # before the client attaches. This is the ONLY trustworthy test of
    # whether `terminal-overrides ...:Sync@` actually suppresses a pane's
    # relayed 2026 brackets - a byte-counting harness gave inconsistent
    # answers, a human watching a border does not.
    pane_cmd='while :; do printf "\033[?2026h\033[H\033[1msync off  \033[0m\033[?2026l"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
  cursor)
    # Bisect half two: cursor hide/show only, no sync brackets.
    pane_cmd='while :; do printf "\033[?25l\033[H\033[1mcursor only\033[0m\033[?25h"; perl -e "select undef,undef,undef,0.1"; done'
    ;;
esac

tmux -L "${SOCK}" new-session -d -s repro "sh -c '${pane_cmd}'"

# Static status bar: no clock, no interval churn, nothing to redraw.
tmux -L "${SOCK}" set -g status-interval 0
tmux -L "${SOCK}" set -g status-right ''
tmux -L "${SOCK}" set -g status-left " flicker repro: ${MODE} mode "

# Mirror the real config's title forwarding, which is what `title` mode
# exercises: with set-titles on, every pane-title sequence tmux receives is
# re-emitted to the outer terminal as a window retitle. allow-rename off
# matches too - it stops the window NAME changing while still letting the
# pane title through, so this is not testing a rename storm.
if [ "${MODE}" = sync-off ]; then
  tmux -L "${SOCK}" set -ags terminal-overrides ',*:Sync@'
fi

tmux -L "${SOCK}" set -g set-titles on
tmux -L "${SOCK}" set -g set-titles-string '#S:#I:#W - "#T" #{session_alerts}'
tmux -L "${SOCK}" setw -g allow-rename off

tmux -L "${SOCK}" bind-key g display-popup -EE -w 72 -h 17 \
  "printf '  Mode: %s\n  Watch the borders.\n  q or Escape to close.\n' '${MODE}'; read -r -n 1 _ || true"

printf 'Throwaway tmux server "%s" is up in %s mode.\n' "${SOCK}" "${MODE}"
printf 'Press C-b g to open the popup, q to close it.\n'
printf 'C-b d detaches and tears the server down.\n'
printf 'Modes: full small title agent sync cursor sync-off\n'
printf 'Start with agent - it replays the real captured frame. If that\n'
printf 'flickers, sync and cursor bisect which half is responsible.\n\n'

tmux -L "${SOCK}" attach -t repro
