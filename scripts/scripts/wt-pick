#!/usr/bin/env bash
#
# wt-pick - Pick a git worktree and act on it
#
#        wt-pick --act <verb> <path>   act on one worktree (used by menu items)
# Usage: wt-pick <switch|remove>
#
# Arguments:
#   switch    attach or create the tmux session for the chosen worktree
#   remove    confirm, then remove the chosen worktree and its session
#
# Lists every worktree of the current repository except the main checkout and
# the one you are standing in. Rendered inline, so it draws in whatever popup
# the caller already has: menus/worktree.menu invokes it, and it also works
# from a plain shell.
#
# Example:
#   wt-pick switch

set -o errexit   # abort on nonzero exitstatus
set -o nounset   # abort on unbound variable
set -o pipefail  # don't hide errors within pipes

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/output.sh"
source "${SCRIPT_DIR}/lib/picker.sh"
source "${SCRIPT_DIR}/lib/menu.sh"
source "${SCRIPT_DIR}/lib/worktree.sh"

# Where sibling scripts are found. Defaults to this script's own
# directory; SCRIPTS_PKG_DIR redirects it, which is how the tests point
# sibling dispatches at recorders. A PATH stub cannot intercept an
# absolute path, and these are all called by absolute path on purpose.
readonly PKG_DIR="${SCRIPTS_PKG_DIR:-${SCRIPT_DIR}}"

readonly PICK_USAGE_ERROR=2

#######################################
# Print usage information
# Outputs:
#   Writes usage information to stdout
#######################################
usage() {
  printf '%s\n' \
    "Usage: ${0##*/} <switch|remove>" \
    "" \
    "Pick a git worktree and act on it." \
    "" \
    "  switch    attach or create the tmux session for the worktree" \
    "  remove    confirm, then remove the worktree and kill its session"
}

#######################################
# Print one row unless it names the main checkout or the current worktree.
# Arguments:
#   Worktree path, branch name, main checkout path, current directory
# Outputs:
#   "path<TAB>basename  branch" to stdout, or nothing
#######################################
emit_worktree_row() {
  local path="${1}"
  local branch="${2}"
  local main_dir="${3}"
  local here="${4}"

  [ -n "${path}" ] || return 0
  local resolved="${path}"
  [ -d "${path}" ] && resolved="$(cd "${path}" && pwd -P)"
  [ "${resolved}" = "${main_dir}" ] && return 0
  [ "${resolved}" = "${here}" ] && return 0

  printf '%s\t%s  %s\n' "${path}" "$(basename "${path}")" "${branch:-?}"
}

#######################################
# Emit one picker row per eligible worktree.
#
# The main checkout is excluded because it is not removable and is not a
# worktree to switch to; the current directory's worktree is excluded because
# both verbs are no-ops on it. `git worktree list --porcelain` puts the main
# checkout first, but it is identified by PATH rather than by position: a
# positional assumption would silently start offering it if the format ever
# grew a leading record.
# Outputs:
#   "path<TAB>basename  branch" rows to stdout
#######################################
worktree_rows() {
  local main_dir here
  main_dir="$(dirname "$(git rev-parse --git-common-dir)")"
  main_dir="$(cd "${main_dir}" && pwd -P)"
  here="$(pwd -P)"

  local line path="" branch=""
  # A blank line terminates each record, so flush there as well as at EOF.
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in
      'worktree '*) path="${line#worktree }" ;;
      'branch refs/heads/'*) branch="${line#branch refs/heads/}" ;;
      'detached') branch="detached" ;;
      '')
        emit_worktree_row "${path}" "${branch}" "${main_dir}" "${here}"
        path=""
        branch=""
        ;;
    esac
  done < <(git worktree list --porcelain)
  emit_worktree_row "${path}" "${branch}" "${main_dir}" "${here}"
}

#######################################
# Attach or create the tmux session for a worktree.
# Arguments:
#   Worktree path
#######################################
do_switch() {
  ts "${1}"
}

#######################################
# Confirm, then remove a worktree and its tmux session.
#
# wt-confirm picks its own renderer from whether it has a tty, and both cases
# reach here. On the native path this runs under a menu item's `run-shell`,
# with no tty and no popup, and wt-confirm asks with a display-menu. On the
# fzf fallback it runs inside the picker's popup, has a tty, and wt-confirm
# renders inline - a display-menu would not draw there at all.
# Arguments:
#   Worktree path
#######################################
do_remove() {
  local path="${1}"
  local session
  session="$(basename "${path}")"

  local gate="${PKG_DIR}/wt-confirm"
  if [ ! -x "${gate}" ]; then
    error "wt-confirm not found or not executable: ${gate}"
    return 1
  fi
  # The gate is handed the action rather than asked for an answer, because
  # display-menu does not reliably block until its menu is answered. It runs
  # --cleanup at whatever point it learns the answer.
  #
  # SCRIPT_DIR, not PKG_DIR: this names THIS script for re-entry, and PKG_DIR
  # is where the tests redirect sibling dispatches to recorders.
  if ! "${gate}" \
      --run "$(printf '%q' "${SCRIPT_DIR}/wt-pick") --cleanup $(printf '%q' "${path}")" \
      "${path}" "${session}"; then
    # Nothing to read, so close the popup rather than making the user dismiss
    # a confirmation they already declined.
    return "${PICKER_QUIET_EXIT}"
  fi
}

#######################################
# Run the cleanup for an already-confirmed worktree.
#
# Its own entry point because the confirmation gate has to be able to name it
# as a command, and because the cleanup needs somewhere to be READ. With a tty
# it already has one - the popup the gate drew in - but reached from a menu
# item it runs under `run-shell -b`, whose stdout tmux writes into the focused
# pane. A pane on the alternate screen, which is any pane running Claude or
# vim, swallows it whole: a cleanup that refused a dirty worktree looked
# exactly like a confirm that did nothing.
#
# The popup is bordered, like git-worktree-done's: this is scrolling command
# output, and the border separates it from the pane behind. It pauses for a
# key, because `display-popup -E` closes the moment its command exits and a
# refusal would otherwise flash past unread.
# Arguments:
#   Worktree path
#######################################
do_cleanup() {
  local path="${1}"

  if [ -t 1 ]; then
    "${PKG_DIR}/git-worktree-cleanup" "${path}"
    return "${?}"
  fi
  tmux display-popup -E -w 80% -h 60% \
    "$(printf '%q' "${PKG_DIR}/git-worktree-cleanup") $(printf '%q' "${path}"); $(printf '%q' "${PKG_DIR}/menu-pause")"
}

#######################################
# Reject anything that is not a known verb.
#
# Both entry points validate, so an --act with a bad verb is a usage error
# rather than a silent no-op.
# Arguments:
#   The verb
# Returns:
#   0 when valid, PICK_USAGE_ERROR otherwise
#######################################
check_verb() {
  case "${1}" in
    switch|remove) return 0 ;;
    '')
      error "missing required argument: verb"
      printf '\n'
      usage
      return "${PICK_USAGE_ERROR}"
      ;;
    *)
      error "unknown verb: ${1}"
      printf '\n'
      usage
      return "${PICK_USAGE_ERROR}"
      ;;
  esac
}

#######################################
# Act on one already-chosen value.
#
# This is what a native menu item invokes: display-menu runs a command rather
# than handing a selection back. The fzf path reaches the same function, which
# is what keeps the two backends honest about doing the same thing.
# Arguments:
#   The verb, the worktree path
# Returns:
#   0 on success, PICK_USAGE_ERROR on a bad invocation
#######################################
act() {
  local verb="${1:-}"
  local path="${2:-}"

  check_verb "${verb}" || return "${?}"
  if [ -z "${path}" ]; then
    error "missing required argument: worktree path"
    return "${PICK_USAGE_ERROR}"
  fi

  case "${verb}" in
    switch) do_switch "${path}" ;;
    remove) do_remove "${path}" ;;
  esac
}

#######################################
# Main function
# Arguments:
#   The verb
# Returns:
#   0 on success or no selection, PICK_USAGE_ERROR on a bad verb
#######################################
main() {
  local verb="${1:-}"

  check_verb "${verb}" || return "${?}"

  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    error "not a git repository"
    return "${PICK_USAGE_ERROR}"
  fi

  local status=0
  worktree_rows \
    | menu_or_pick "Worktree to ${verb}" \
        "$(printf '%q' "${SCRIPT_DIR}/wt-pick") --act ${verb}" \
        "$(printf '%q' "${SCRIPT_DIR}/wt-pick") ${verb}" \
        --size "" --style default --info hidden \
        --prompt "Worktree to ${verb}> " \
        --empty-message "No other worktrees." \
    || status="${?}"

  # An empty list has printed its message and the user needs a moment to read
  # it, so it reports success and fzf-menu pauses. An escape (QUIET_EXIT)
  # propagates, so the popup closes without a pause. Same contract the
  # fzf-only version had.
  #
  # Captured with || rather than read afterwards: errexit aborts main on a
  # nonzero pipeline, so a plain "${?}" on the next line never runs.
  if [ "${status}" -eq "${PICKER_EMPTY}" ]; then
    return 0
  fi
  return "${status}"
}

case "${1:-}" in
  # The act half, invoked by a native menu item.
  --act)
    shift
    act ${1+"${@}"}
    exit "${?}"
    ;;
  # Invoked by the confirmation gate once the user has said yes. Not a verb:
  # nothing may reach this without going through the gate first.
  --cleanup)
    shift
    if [ "${#}" -lt 1 ] || [ -z "${1}" ]; then
      error "missing required argument: worktree path"
      exit "${PICK_USAGE_ERROR}"
    fi
    do_cleanup "${1}"
    exit "${?}"
    ;;
esac

# Check for help flag
# ${1+...} is for bash 3.2, which is still /bin/bash on a stock macOS and
# on the macos-latest runner: there "${@}" with no positional parameters is
# an unbound variable under `set -o nounset` rather than an empty list, so a
# no-argument run aborted here instead of printing usage.
if help_wanted ${1+"${@}"}; then
  usage
  exit 0
fi

# Run main function
main ${1+"${@}"}
