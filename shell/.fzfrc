# bg/fg/gutter follow the terminal rather than pinning a theme's hex.
# They live here, not in FZF_DEFAULT_OPTS: the tmux server snapshots its
# environment at start, and `display-popup` sources no profile, so an
# env-carried colour is stale in every popup until the server restarts.
# This file is read from disk on every fzf run.
--color=bg:-1,fg:-1,gutter:-1
--style full
--border --padding 1,2
--preview 'fzf-preview.sh {}'
--input-label ' Input '
--header-label ' File Type '
--bind 'result:transform-list-label:
    if [[ -z $FZF_QUERY ]]; then
        echo " $FZF_MATCH_COUNT items "
    else
        echo " $FZF_MATCH_COUNT matches for [$FZF_QUERY] "
    fi
    '
--bind 'focus:transform-preview-label:[[ -n {} ]] && printf " Previewing [%s] " {}'
--tmux bottom,50%
